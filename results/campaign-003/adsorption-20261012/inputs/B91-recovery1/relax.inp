        MAX_SCF 10
      &END OUTER_SCF
      &PRINT
        &RESTART
          LOG_PRINT_KEY T
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
