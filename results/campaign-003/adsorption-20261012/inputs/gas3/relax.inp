&GLOBAL
  PROJECT HAP-C003-gas3
  RUN_TYPE GEO_OPT
  WALLTIME 1620
  PRINT_LEVEL MEDIUM
  PREFERRED_FFT_LIBRARY FFTW3
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME /opt/cp2k/data/BASIS_MOLOPT
    POTENTIAL_FILE_NAME /opt/cp2k/data/GTH_POTENTIALS
    CHARGE 0
    MULTIPLICITY 1
    UKS F
    SURFACE_DIPOLE_CORRECTION T
    SURF_DIP_DIR Z
    SURF_DIP_POS 2.0
    SURF_DIP_SWITCH F
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
    &END QS
    &MGRID
      NGRIDS 4
      CUTOFF [Ry] 1200
      REL_CUTOFF [Ry] 80
    &END MGRID
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      MAX_SCF 80
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-8
        MAX_SCF 10
      &END OUTER_SCF
      &PRINT
        &RESTART
          LOG_PRINT_KEY T
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3(BJ)
          REFERENCE_FUNCTIONAL PBE
          PARAMETER_FILE_NAME /opt/cp2k/data/dftd3.dat
          R_CUTOFF [angstrom] 15.0
          CALCULATE_C9_TERM F
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
  &END DFT
  &SUBSYS
    &CELL
      A [angstrom] 9.424000000000 0.000000000000 0.000000000000
      B [angstrom] -4.712000000000 8.161423405265 0.000000000000
      C [angstrom] 0.000000000000 0.000000000000 37.740114600000
      PERIODIC XYZ
    &END CELL
    &COORD
      UNIT angstrom
      C 2.3559999999999999 4.0807117026324997 18.870057299999999
      O 2.3560019735999997 4.0807146727324994 17.689062663600001
      O 2.3560000468999993 4.080709364132499 20.037759885300002
    &END COORD
    &KIND O
      ELEMENT O
      BASIS_SET DZVP-MOLOPT-SR-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND C
      ELEMENT C
      BASIS_SET DZVP-MOLOPT-SR-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
      NDIGITS 14
      FORCE_UNIT hartree/bohr
      FILENAME __STD_OUT__
      ADD_LAST NO
      &EACH
        GEO_OPT 1
      &END EACH
    &END FORCES
  &END PRINT
&END FORCE_EVAL
&MOTION
  &GEO_OPT
    TYPE MINIMIZATION
    OPTIMIZER BFGS
    MAX_ITER 40
    STEP_START_VAL 0
    MAX_FORCE [hartree/bohr] 0.0001944690381148888
    RMS_FORCE [hartree/bohr] 9.723451905744438e-05
    MAX_DR [bohr] 0.003
    RMS_DR [bohr] 0.0015
    KEEP_SPACE_GROUP F
    &BFGS
      TRUST_RADIUS [angstrom] 0.05
      RESTART_HESSIAN F
      USE_RAT_FUN_OPT F
    &END BFGS
    &PRINT
      &PROGRAM_RUN_INFO ON
      &END PROGRAM_RUN_INFO
    &END PRINT
  &END GEO_OPT
  &PRINT
    &STRUCTURE_DATA ON
      FILENAME __STD_OUT__
      UNIT angstrom
      ADD_LAST NO
      POSITION 1 2 3
      &EACH
        GEO_OPT 1
      &END EACH
    &END STRUCTURE_DATA
    &TRAJECTORY ON
      FILENAME =HAP91-relax-pos.xyz
      FORMAT XYZ
      UNIT angstrom
      ADD_LAST NO
      LOG_PRINT_KEY T
      &EACH
        GEO_OPT 1
      &END EACH
    &END TRAJECTORY
    &FORCES ON
      FILENAME =HAP91-relax-frc.xyz
      FORMAT XYZ
      UNIT hartree/bohr
      ADD_LAST NO
      LOG_PRINT_KEY T
      &EACH
        GEO_OPT 1
      &END EACH
    &END FORCES
    &CELL ON
      FILENAME =HAP91-relax.cell
      ADD_LAST NO
      &EACH
        GEO_OPT 1
      &END EACH
    &END CELL
    &RESTART ON
      BACKUP_COPIES 6
      ADD_LAST NUMERIC
      LOG_PRINT_KEY T
      &EACH
        GEO_OPT 1
      &END EACH
    &END RESTART
    &RESTART_HISTORY ON
      ADD_LAST NUMERIC
      &EACH
        GEO_OPT 1
      &END EACH
    &END RESTART_HISTORY
  &END PRINT
&END MOTION
