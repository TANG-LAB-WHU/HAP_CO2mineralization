&GLOBAL
  PROJECT HAP-C003-clean88
  RUN_TYPE GEO_OPT
  WALLTIME 1620
  PRINT_LEVEL MEDIUM
  PREFERRED_FFT_LIBRARY FFTW3
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME /opt/cp2k/data/BASIS_MOLOPT
    POTENTIAL_FILE_NAME /opt/cp2k/data/GTH_POTENTIALS
    WFN_RESTART_FILE_NAME /seed/HAP91-converged-parent.wfn
    CHARGE 0
    MULTIPLICITY 1
    UKS F
    SURFACE_DIPOLE_CORRECTION T
    SURF_DIP_DIR Z
    SURF_DIP_POS 2.0
    SURF_DIP_SWITCH F
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
    &END QS
    &MGRID
      NGRIDS 4
      CUTOFF [Ry] 1200
      REL_CUTOFF [Ry] 80
    &END MGRID
    &SCF
      SCF_GUESS RESTART
      EPS_SCF 1.0E-8
      MAX_SCF 80
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-8
        MAX_SCF 10
      &END OUTER_SCF
      &PRINT
        &RESTART
          LOG_PRINT_KEY T
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3(BJ)
          REFERENCE_FUNCTIONAL PBE
          PARAMETER_FILE_NAME /opt/cp2k/data/dftd3.dat
          R_CUTOFF [angstrom] 15.0
          CALCULATE_C9_TERM F
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
  &END DFT
