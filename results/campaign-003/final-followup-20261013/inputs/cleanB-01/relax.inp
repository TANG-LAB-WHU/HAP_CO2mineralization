&MOTION
  &GEO_OPT
    TYPE MINIMIZATION
    OPTIMIZER BFGS
    MAX_ITER 10
    STEP_START_VAL 0
    MAX_FORCE [hartree/bohr] 0.0001944690381148888
    RMS_FORCE [hartree/bohr] 9.723451905744438e-05
    MAX_DR [bohr] 0.003
    RMS_DR [bohr] 0.0015
    KEEP_SPACE_GROUP F
    &BFGS
      TRUST_RADIUS [angstrom] 0.05
      RESTART_HESSIAN F
      USE_RAT_FUN_OPT F
    &END BFGS
    &PRINT
      &PROGRAM_RUN_INFO ON
      &END PROGRAM_RUN_INFO
    &END PRINT
