    &RESTART ON
      BACKUP_COPIES 6
      ADD_LAST NUMERIC
      LOG_PRINT_KEY T
      &EACH
        GEO_OPT 1
      &END EACH
    &END RESTART
    &RESTART_HISTORY ON
      ADD_LAST NUMERIC
      &EACH
        GEO_OPT 1
      &END EACH
