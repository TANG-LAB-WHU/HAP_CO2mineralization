# PLANNED: materialize only from an accepted recorded endpoint. No invented coordinates.
&GLOBAL
  PROJECT __PROBE_PROJECT_STEP40_OR_STEP80__
  RUN_TYPE ENERGY_FORCE
  SEED 2026101102
  WALLTIME 1740
  PRINT_LEVEL MEDIUM
  PREFERRED_FFT_LIBRARY FFTW3
  &PRINT ON
    PHYSCON T
  &END PRINT
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    WFN_RESTART_FILE_NAME /seed/HAP91-converged-parent.wfn
    BASIS_SET_FILE_NAME /opt/cp2k/data/BASIS_MOLOPT
    POTENTIAL_FILE_NAME /opt/cp2k/data/GTH_POTENTIALS
    CHARGE 0
    MULTIPLICITY 1
    UKS F
    SURFACE_DIPOLE_CORRECTION T
    SURF_DIP_DIR Z
    SURF_DIP_POS 2.0
    SURF_DIP_SWITCH F
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
    &END QS
    &MGRID
      NGRIDS 4
      CUTOFF [Ry] 1200
      REL_CUTOFF [Ry] 80
    &END MGRID
    &SCF
      SCF_GUESS RESTART
      EPS_SCF 1.0E-8
      MAX_SCF 80
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-8
        MAX_SCF 10
      &END OUTER_SCF
      &PRINT
        &RESTART
          LOG_PRINT_KEY T
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3(BJ)
          REFERENCE_FUNCTIONAL PBE
          PARAMETER_FILE_NAME /opt/cp2k/data/dftd3.dat
          R_CUTOFF [angstrom] 15.0
          CALCULATE_C9_TERM F
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
  &END DFT
  &SUBSYS
    &CELL
      A [angstrom] 9.424000000000 0.000000000000 0.000000000000
      B [angstrom] -4.712000000000 8.161423405265 0.000000000000
      C [angstrom] 0.000000000000 0.000000000000 37.740114600000
      PERIODIC XYZ
    &END CELL
    &COORD
      UNIT angstrom
      __EXACT_91_ATOM_COORDINATES_FROM_STEP40_OR_STEP80_IN_FROZEN_ID_ORDER__
    &END COORD
    &KIND Ca
      ELEMENT Ca
      BASIS_SET DZVP-MOLOPT-SR-GTH-q10
      POTENTIAL GTH-PBE-q10
    &END KIND
    &KIND P
      ELEMENT P
      BASIS_SET DZVP-MOLOPT-SR-GTH-q5
      POTENTIAL GTH-PBE-q5
    &END KIND
    &KIND O
      ELEMENT O
      BASIS_SET DZVP-MOLOPT-SR-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND H
      ELEMENT H
      BASIS_SET DZVP-MOLOPT-SR-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND C
      ELEMENT C
      BASIS_SET DZVP-MOLOPT-SR-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
      NDIGITS 14
      FORCE_UNIT hartree/bohr
      FILENAME __STD_OUT__
      ADD_LAST NO
    &END FORCES
  &END PRINT
&END FORCE_EVAL
