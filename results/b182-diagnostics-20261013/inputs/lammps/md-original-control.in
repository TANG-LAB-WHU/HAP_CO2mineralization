units metal
atom_style atomic
boundary p p p
read_data md.system.data
pair_style deepmd model.pth
pair_coeff * * Ca P O H C
neighbor 1.0 bin
neigh_modify every 1 delay 0 check yes
thermo 1
thermo_style custom step time atoms temp pe ke etotal
thermo_modify lost error norm no flush yes format float %.17g
compute_modify thermo_temp extra/dof 3
reset_timestep 0
timestep .00025
fix integrate all nve
variable current_temp equal temp
fix stop_temperature all halt 1 v_current_temp >= 1000.0 error hard message yes
dump trajectory all custom 1 trajectory.dump id type mass x y z xu yu zu ix iy iz vx vy vz fx fy fz
dump_modify trajectory sort id first yes pbc yes flush yes format float %.17g
run 80
print "jump SELF stop_exploration" file checkpoint-decision.in screen no
shell /opt/deepmd-kit/bin/python -B /runner/b182_exploratory_worker.py checkpoint --expected 80
include checkpoint-decision.in
run 20
print "jump SELF stop_exploration" file checkpoint-decision.in screen no
